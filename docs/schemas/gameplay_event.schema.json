{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yn217/Convenience_store_Sim/blob/main/docs/schemas/gameplay_event.schema.json",
  "title": "ConvenienceStoreMVPGameplayEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "name_ja",
    "description_ja",
    "weight",
    "min_day_index",
    "min_reputation",
    "window_start_hour",
    "window_end_hour",
    "effects",
    "visual_theme",
    "tone"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9_]+$"
    },
    "name_ja": {
      "type": "string",
      "minLength": 1
    },
    "description_ja": {
      "type": "string",
      "minLength": 1
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "min_day_index": {
      "type": "integer",
      "minimum": 1
    },
    "min_reputation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "window_start_hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "window_end_hour": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traffic_multiplier",
        "category_weight_multipliers"
      ],
      "properties": {
        "traffic_multiplier": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "category_weight_multipliers": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "rice_ball",
              "oden",
              "instant_noodle",
              "bread",
              "drink",
              "snack",
              "dessert",
              "ice_cream",
              "bento",
              "daily_fresh",
              "coffee"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.8
          }
        }
      }
    },
    "visual_theme": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_]+$"
    },
    "tone": {
      "enum": [
        "opportunity",
        "challenge"
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "description": "Optional player choices (2026-11-13). Exactly one has cost_yen 0: it holds when the player does not pick. A paid choice is booked as a PROMO expense.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice_id",
          "label_ja",
          "description_ja",
          "cost_yen",
          "effects",
          "line_ja"
        ],
        "properties": {
          "choice_id": {
            "type": "string",
            "minLength": 1
          },
          "label_ja": {
            "type": "string",
            "minLength": 1
          },
          "description_ja": {
            "type": "string",
            "minLength": 1
          },
          "cost_yen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "traffic_multiplier",
              "category_weight_multipliers"
            ],
            "properties": {
              "traffic_multiplier": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.6
              },
              "category_weight_multipliers": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "rice_ball",
                    "oden",
                    "instant_noodle",
                    "bread",
                    "drink",
                    "snack",
                    "dessert",
                    "ice_cream",
                    "bento",
                    "daily_fresh",
                    "coffee"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 2.0
                }
              }
            }
          },
          "line_ja": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
