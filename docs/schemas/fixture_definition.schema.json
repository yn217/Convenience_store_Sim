{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yn217/Convenience_store_Sim/blob/main/docs/schemas/fixture_definition.schema.json",
  "title": "fixture_definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dimensions_m": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "depth",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "placement_cost_yen": {
      "type": "integer",
      "minimum": 0
    },
    "electricity_cost_yen_per_day": {
      "type": "integer",
      "minimum": 0
    },
    "capacity_units": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "rice_ball",
          "oden",
          "instant_noodle",
          "bread",
          "drink",
          "snack",
          "dessert",
          "ice_cream",
          "bento",
          "daily_fresh",
          "coffee",
          "capsule_toy",
          "daily_goods",
          "hygiene",
          "character_goods",
          "soft_serve",
          "frappe",
          "bakery",
          "pizza"
        ]
      }
    },
    "access_edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "N",
          "E",
          "S",
          "W"
        ]
      }
    },
    "visual_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "shelf_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "capacity_units",
          "allowed_categories"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "capacity_units": {
            "type": "integer",
            "minimum": 1
          },
          "allowed_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "rice_ball",
                "oden",
                "instant_noodle",
                "bread",
                "drink",
                "snack",
                "dessert",
                "ice_cream",
                "bento",
                "daily_fresh",
                "coffee",
                "capsule_toy",
                "daily_goods",
                "hygiene",
                "character_goods",
                "soft_serve",
                "frappe",
                "bakery",
                "pizza"
              ]
            }
          }
        }
      }
    },
    "register_queue_max_tiles": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "type_id",
    "display_name",
    "footprint",
    "dimensions_m",
    "placement_cost_yen",
    "electricity_cost_yen_per_day",
    "capacity_units",
    "allowed_categories",
    "access_edges",
    "visual_id",
    "shelf_slots"
  ]
}
