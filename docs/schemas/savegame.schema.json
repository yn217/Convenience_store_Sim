{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yn217/Convenience_store_Sim/blob/main/docs/schemas/savegame.schema.json",
  "title": "savegame.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "3 = visit purposes (issue #141): optional customers[].visit, rng_states.visits / impulse. 2 = basket purchases (issue #128). 1 = single item per visit; loaded as basket_size 1 with no basket_wishes.",
      "enum": [1, 2, 3]
    },
    "save_id": {
      "type": "string",
      "minLength": 1
    },
    "saved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "game_tick": {
      "type": "integer",
      "minimum": 0
    },
    "game_time_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "speed_setting": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        4
      ]
    },
    "business_state": {
      "enum": [
        "SETUP",
        "OPEN",
        "CLOSING",
        "PAYMENT_BLOCKED"
      ]
    },
    "rng_states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrivals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "purchases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "visuals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "arrivals",
        "purchases",
        "visuals",
        "events"
      ]
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "entrance_tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        }
      },
      "required": [
        "store_id",
        "width",
        "height",
        "entrance_tiles"
      ]
    },
    "fixture_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "type_id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "instance_id",
          "type_id",
          "x",
          "y",
          "rotation",
          "enabled"
        ]
      }
    },
    "inventory_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "sku_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_cost_yen": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at_sec": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "physical_qty": {
            "type": "integer",
            "minimum": 0
          },
          "reserved_qty": {
            "type": "integer",
            "minimum": 0
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "BACKROOM",
                  "FIXTURE"
                ]
              },
              "fixture_id": {
                "type": "string",
                "minLength": 1
              },
              "slot_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "FIXTURE"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "kind",
                    "fixture_id",
                    "slot_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "BACKROOM"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "fixture_id"
                        ]
                      },
                      {
                        "required": [
                          "slot_id"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "segment_id",
          "lot_id",
          "sku_id",
          "unit_cost_yen",
          "expires_at_sec",
          "physical_qty",
          "reserved_qty",
          "location"
        ]
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reservation_id": {
            "type": "string",
            "minLength": 1
          },
          "customer_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "sell_unit_yen_snapshot": {
            "type": "integer",
            "minimum": 1
          },
          "cost_unit_yen_snapshot": {
            "type": "integer",
            "minimum": 0
          },
          "reservation_expires_at_sec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "reservation_id",
          "customer_id",
          "segment_id",
          "qty",
          "sell_unit_yen_snapshot",
          "cost_unit_yen_snapshot",
          "reservation_expires_at_sec"
        ]
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "SPAWN",
              "SELECT_SHELF",
              "WALK_TO_ACCESS",
              "INSPECT",
              "WALK_TO_REGISTER",
              "QUEUE",
              "CHECKOUT",
              "EXIT",
              "CANCELLED",
              "APPROACH",
              "ENTER",
              "WALK_AWAY"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "route_index": {
            "type": "integer",
            "minimum": 0
          },
          "reservation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "patience_remaining_sec": {
            "type": "integer",
            "minimum": 0
          },
          "target_fixture_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkout_remaining_sec": {
            "type": "integer",
            "minimum": 0
          },
          "target_sku_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "queue_slot": {
            "type": "integer",
            "minimum": -1
          },
          "register_id": {
            "type": "string"
          },
          "retries": {
            "type": "integer",
            "minimum": 0
          },
          "walk_progress": {
            "type": "number",
            "minimum": 0
          },
          "queue_since_sec": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "type": "string"
          },
          "basket_size": {
            "description": "Items the customer came in for (1..4). Absent in schema 1 saves = 1.",
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "visit": {
            "description": "Why the customer came and what it carries (issue #141). Absent (schema 1/2) = no purpose.",
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose_id", "budget_yen", "wallet_yen", "planned_yen", "impulse_count", "basket_log", "seen_categories", "impulse_tried"],
            "properties": {
              "purpose_id": {"type": "string"},
              "budget_yen": {"type": "integer", "minimum": 0},
              "wallet_yen": {"type": "integer", "minimum": 0},
              "planned_yen": {"type": "integer", "minimum": 0},
              "impulse_count": {"type": "integer", "minimum": 0},
              "basket_log": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sku_id", "price_yen", "kind", "state"],
                  "properties": {
                    "sku_id": {"type": "string", "minLength": 1},
                    "price_yen": {"type": "integer"},
                    "kind": {"enum": ["target", "impulse"]},
                    "state": {"enum": ["planned", "taken", "not_bought", "too_expensive", "stockout"]}
                  }
                }
              },
              "seen_categories": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "impulse_tried": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "segment_id": {"description": "Customer segment of a visitor sent by a nearby facility (issue #149); absent or \"\" for the location's own visitors.", "type": "string"}
            }
          },
          "browse_remaining_sec": {
            "description": "Game seconds the customer still looks over the shelf it stands at before taking the item; -1 = not browsing (issue #117 v2). Absent = -1.",
            "type": "integer",
            "minimum": -1
          },
          "basket_wishes": {
            "description": "Items still to walk to, nearest first when visited (issue #128). Absent in schema 1 saves = [].",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sku_id": {"type": "string", "minLength": 1},
                "fixture_id": {"type": "string", "minLength": 1}
              },
              "required": ["sku_id", "fixture_id"]
            }
          }
        },
        "required": [
          "customer_id",
          "phase",
          "position",
          "route",
          "route_index",
          "reservation_ids",
          "patience_remaining_sec",
          "target_fixture_id",
          "checkout_remaining_sec"
        ]
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash_yen": {
          "type": "integer",
          "minimum": 0
        },
        "ledger_transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "event_type": {
                "enum": [
                  "ORDER",
                  "SALE",
                  "AD",
                  "DAILY_FIXED",
                  "ELECTRICITY",
                  "WAGES",
                  "PROMO",
                  "DISCOUNT",
                  "WASTAGE",
                  "FIXTURE_PURCHASE",
                  "REVERSAL"
                ]
              },
              "day_index": {
                "type": "integer",
                "minimum": 0
              },
              "time_sec": {
                "type": "integer",
                "minimum": 0
              },
              "cash_delta_yen": {
                "type": "integer"
              },
              "revenue_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "cogs_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "expense_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "event_id",
              "event_type",
              "day_index",
              "time_sec",
              "cash_delta_yen",
              "revenue_delta_yen",
              "cogs_delta_yen",
              "expense_delta_yen"
            ]
          }
        },
        "unpaid_cost_yen": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cash_yen",
        "ledger_transactions",
        "unpaid_cost_yen"
      ]
    },
    "advertising": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "today_budget_yen": {
          "type": "integer",
          "minimum": 0
        },
        "next_day_budget_yen": {
          "type": "integer",
          "minimum": 0
        },
        "last_charged_day": {
          "type": "integer",
          "minimum": -1
        }
      },
      "required": [
        "today_budget_yen",
        "next_day_budget_yen",
        "last_charged_day"
      ]
    },
    "daily_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "type": "integer",
            "minimum": 0
          },
          "revenue_yen": {
            "type": "integer",
            "minimum": 0
          },
          "cogs_yen": {
            "type": "integer",
            "minimum": 0
          },
          "gross_profit_yen": {
            "type": "integer"
          },
          "wastage_yen": {
            "type": "integer",
            "minimum": 0
          },
          "advertising_yen": {
            "type": "integer",
            "minimum": 0
          },
          "electricity_yen": {
            "type": "integer",
            "minimum": 0
          },
          "fixed_cost_yen": {
            "type": "integer",
            "minimum": 0
          },
          "operating_profit_yen": {
            "type": "integer"
          },
          "net_cash_delta_yen": {
            "type": "integer"
          },
          "cash_end_yen": {
            "type": "integer",
            "minimum": 0
          },
          "store_reputation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "potential_customers": {
            "type": "integer",
            "minimum": 0
          },
          "visitors": {
            "type": "integer",
            "minimum": 0
          },
          "purchasing_customers": {
            "type": "integer",
            "minimum": 0
          },
          "lost_customers": {
            "type": "integer",
            "minimum": 0
          },
          "balked_customers": {
            "description": "Customers who turned back at the door because of the line (issue #142); part of lost_customers. Absent in older saves.",
            "type": "integer",
            "minimum": 0
          },
          "units_sold": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "day_index",
          "revenue_yen",
          "cogs_yen",
          "gross_profit_yen",
          "wastage_yen",
          "advertising_yen",
          "electricity_yen",
          "fixed_cost_yen",
          "operating_profit_yen",
          "net_cash_delta_yen",
          "cash_end_yen",
          "store_reputation",
          "potential_customers",
          "visitors",
          "purchasing_customers",
          "lost_customers",
          "units_sold"
        ]
      }
    },
    "applied_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "store_reputation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "product_price_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "applied_command_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gameplay_event_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_selected_day": {
          "type": "integer",
          "minimum": -1
        },
        "selection_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_start_sec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_end_sec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "started": {
          "type": "boolean"
        },
        "ended": {
          "type": "boolean"
        },
        "shown_notice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "last_selected_day",
        "selection_event_id",
        "selected_event_id",
        "event_start_sec",
        "event_end_sec",
        "started",
        "ended",
        "shown_notice_ids"
      ]
    },
    "progression_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tutorial_skipped": {
          "type": "boolean"
        },
        "tutorial_step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "completed_milestone_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "completed_daily_challenge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "active_daily_challenge_day": {
          "type": "integer",
          "minimum": -1
        },
        "active_daily_challenge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "challenge_stock_qualified": {
          "type": "boolean"
        },
        "dismissed_story_cue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "tutorial_skipped",
        "tutorial_step_index",
        "completed_milestone_ids",
        "completed_daily_challenge_ids",
        "active_daily_challenge_day",
        "active_daily_challenge_id",
        "challenge_stock_qualified",
        "dismissed_story_cue_ids"
      ]
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "Added with M4-03 (#20): runtime values the other sections have no slot for. Optional; loaders fall back to ids found in the data.",
      "properties": {
        "id_counters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixture": {
              "type": "integer",
              "minimum": 0
            },
            "lot": {
              "type": "integer",
              "minimum": 0
            },
            "segment": {
              "type": "integer",
              "minimum": 0
            },
            "customer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "visit_stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "potential": {
              "type": "integer",
              "minimum": 0
            },
            "entered": {
              "type": "integer",
              "minimum": 0
            },
            "lost": {
              "type": "integer",
              "minimum": 0
            },
            "purchased": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "staff": {
          "description": "Store staff (issue #143): id, name, archetype, skills 1..5, fatigue 0..100, phase, position, route, walk_progress, timer, carry and the current restock task. Absent = the balance's starting staff.",
          "type": "array",
          "items": {"type": "object"}
        },
        "next_staff_seq": {"type": "integer", "minimum": 0},
        "staff_candidates": {"description": "Today's hiring candidates (issue #144).", "type": "array", "items": {"type": "object"}},
        "promotions": {"description": "Promotions (issue #137): {promotion_id, def_id, start_day, end_day} (inclusive days), running and finished.", "type": "array", "items": {"type": "object"}},
        "next_promotion_seq": {"type": "integer", "minimum": 0},
        "promo_stats": {"description": "Results per promotion id (issue #137): {units, discount_yen}.", "type": "object"},
        "map_id": {"description": "Area map of the store's site (issue #150), e.g. aoba_town_v1; \"\" when chosen without the map.", "type": "string"},
        "plot_id": {"description": "The store's site on that map (issue #150); \"\" when the location was chosen by hand.", "type": "string"},
        "facilities": {"description": "Nearby facility ids (issue #149), at most max_facilities.", "type": "array", "items": {"type": "string"}},
        "facility_visits": {"description": "Visitors each facility sent today (issue #149).", "type": "object"},
        "location_id": {"description": "Store location (issue #148): station / school / office / residential, or \"\" for the standard store.", "type": "string"},
        "last_nonzero_speed": {
          "type": "integer",
          "enum": [
            1,
            2,
            4
          ]
        },
        "rate_stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "abandoned": {
              "type": "integer",
              "minimum": 0
            },
            "stockouts": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "save_id",
    "saved_at_utc",
    "game_tick",
    "game_time_seconds",
    "speed_setting",
    "business_state",
    "rng_states",
    "store",
