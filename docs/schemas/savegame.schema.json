{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yn217/Convenience_store_Sim/blob/main/docs/schemas/savegame.schema.json",
  "title": "savegame.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "save_id": {
      "type": "string",
      "minLength": 1
    },
    "saved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "game_tick": {
      "type": "integer",
      "minimum": 0
    },
    "game_time_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "speed_setting": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        4
      ]
    },
    "business_state": {
      "enum": [
        "SETUP",
        "OPEN",
        "CLOSING",
        "PAYMENT_BLOCKED"
      ]
    },
    "rng_states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrivals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "purchases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "visuals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "arrivals",
        "purchases",
        "visuals",
        "events"
      ]
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "entrance_tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        }
      },
      "required": [
        "store_id",
        "width",
        "height",
        "entrance_tiles"
      ]
    },
    "fixture_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "type_id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "instance_id",
          "type_id",
          "x",
          "y",
          "rotation",
          "enabled"
        ]
      }
    },
    "inventory_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "sku_id": {
            "type": "string",
            "minLength": 1
          },
          "unit_cost_yen": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at_sec": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "physical_qty": {
            "type": "integer",
            "minimum": 0
          },
          "reserved_qty": {
            "type": "integer",
            "minimum": 0
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "BACKROOM",
                  "FIXTURE"
                ]
              },
              "fixture_id": {
                "type": "string",
                "minLength": 1
              },
              "slot_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "FIXTURE"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "kind",
                    "fixture_id",
                    "slot_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "BACKROOM"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "fixture_id"
                        ]
                      },
                      {
                        "required": [
                          "slot_id"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "segment_id",
          "lot_id",
          "sku_id",
          "unit_cost_yen",
          "expires_at_sec",
          "physical_qty",
          "reserved_qty",
          "location"
        ]
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reservation_id": {
            "type": "string",
            "minLength": 1
          },
          "customer_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          },
          "sell_unit_yen_snapshot": {
            "type": "integer",
            "minimum": 1
          },
          "cost_unit_yen_snapshot": {
            "type": "integer",
            "minimum": 0
          },
          "reservation_expires_at_sec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "reservation_id",
          "customer_id",
          "segment_id",
          "qty",
          "sell_unit_yen_snapshot",
          "cost_unit_yen_snapshot",
          "reservation_expires_at_sec"
        ]
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "SPAWN",
              "SELECT_SHELF",
              "WALK_TO_ACCESS",
              "INSPECT",
              "WALK_TO_REGISTER",
              "QUEUE",
              "CHECKOUT",
              "EXIT",
              "CANCELLED"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "route": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "route_index": {
            "type": "integer",
            "minimum": 0
          },
          "reservation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "patience_remaining_sec": {
            "type": "integer",
            "minimum": 0
          },
          "target_fixture_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkout_remaining_sec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "customer_id",
          "phase",
          "position",
          "route",
          "route_index",
          "reservation_ids",
          "patience_remaining_sec",
          "target_fixture_id",
          "checkout_remaining_sec"
        ]
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash_yen": {
          "type": "integer",
          "minimum": 0
        },
        "ledger_transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "event_type": {
                "enum": [
                  "ORDER",
                  "SALE",
                  "AD",
                  "DAILY_FIXED",
                  "ELECTRICITY",
                  "WASTAGE",
                  "FIXTURE_PURCHASE",
                  "REVERSAL"
                ]
              },
              "day_index": {
                "type": "integer",
                "minimum": 0
              },
              "time_sec": {
                "type": "integer",
                "minimum": 0
              },
              "cash_delta_yen": {
                "type": "integer"
              },
              "revenue_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "cogs_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "expense_delta_yen": {
                "type": "integer",
                "minimum": 0
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "event_id",
              "event_type",
              "day_index",
              "time_sec",
              "cash_delta_yen",
              "revenue_delta_yen",
              "cogs_delta_yen",
              "expense_delta_yen"
            ]
          }
        },
        "unpaid_cost_yen": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cash_yen",
        "ledger_transactions",
        "unpaid_cost_yen"
      ]
    },
    "advertising": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "today_budget_yen": {
          "type": "integer",
          "minimum": 0
        },
        "next_day_budget_yen": {
          "type": "integer",
          "minimum": 0
        },
        "last_charged_day": {
          "type": "integer",
          "minimum": -1
        }
      },
      "required": [
        "today_budget_yen",
        "next_day_budget_yen",
        "last_charged_day"
      ]
    },
    "daily_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "type": "integer",
            "minimum": 0
          },
          "revenue_yen": {
            "type": "integer",
            "minimum": 0
          },
          "cogs_yen": {
            "type": "integer",
            "minimum": 0
          },
          "gross_profit_yen": {
            "type": "integer"
          },
          "wastage_yen": {
            "type": "integer",
            "minimum": 0
          },
          "advertising_yen": {
            "type": "integer",
            "minimum": 0
          },
          "electricity_yen": {
            "type": "integer",
            "minimum": 0
          },
          "fixed_cost_yen": {
            "type": "integer",
            "minimum": 0
          },
          "operating_profit_yen": {
            "type": "integer"
          },
          "net_cash_delta_yen": {
            "type": "integer"
          },
          "cash_end_yen": {
            "type": "integer",
            "minimum": 0
          },
          "store_reputation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "potential_customers": {
            "type": "integer",
            "minimum": 0
          },
          "visitors": {
            "type": "integer",
            "minimum": 0
          },
          "purchasing_customers": {
            "type": "integer",
            "minimum": 0
          },
          "lost_customers": {
            "type": "integer",
            "minimum": 0
          },
          "units_sold": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "day_index",
          "revenue_yen",
          "cogs_yen",
          "gross_profit_yen",
          "wastage_yen",
          "advertising_yen",
          "electricity_yen",
          "fixed_cost_yen",
          "operating_profit_yen",
          "net_cash_delta_yen",
          "cash_end_yen",
          "store_reputation",
          "potential_customers",
          "visitors",
          "purchasing_customers",
          "lost_customers",
          "units_sold"
        ]
      }
    },
    "applied_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "store_reputation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "product_price_overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "applied_command_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gameplay_event_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_selected_day": {
          "type": "integer",
          "minimum": -1
        },
        "selection_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_start_sec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_end_sec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "started": {
          "type": "boolean"
        },
        "ended": {
          "type": "boolean"
        },
        "shown_notice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "last_selected_day",
        "selection_event_id",
        "selected_event_id",
        "event_start_sec",
        "event_end_sec",
        "started",
        "ended",
        "shown_notice_ids"
      ]
    },
    "progression_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tutorial_skipped": {
          "type": "boolean"
        },
        "tutorial_step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "completed_milestone_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "completed_daily_challenge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "active_daily_challenge_day": {
          "type": "integer",
          "minimum": -1
        },
        "active_daily_challenge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "challenge_stock_qualified": {
          "type": "boolean"
        },
        "dismissed_story_cue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "tutorial_skipped",
        "tutorial_step_index",
        "completed_milestone_ids",
        "completed_daily_challenge_ids",
        "active_daily_challenge_day",
        "active_daily_challenge_id",
        "challenge_stock_qualified",
        "dismissed_story_cue_ids"
      ]
    }
  },
  "required": [
    "schema_version",
    "save_id",
    "saved_at_utc",
    "game_tick",
    "game_time_seconds",
    "speed_setting",
    "business_state",
    "rng_states",
    "store",
    "fixture_instances",
    "inventory_segments",
    "reservations",
    "customers",
    "economy",
    "advertising",
    "daily_reports",
    "applied_event_ids",
    "store_reputation",
    "product_price_overrides",
    "applied_command_ids",
    "gameplay_event_state",
    "progression_state"
  ]
}
